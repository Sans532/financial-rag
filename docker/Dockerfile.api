FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# CPU-only torch first: the default PyPI wheel bundles multi-GB CUDA libraries this
# container never uses (no GPU here), which was blowing past typical local Docker VM
# disk allocations. Installing the CPU wheel from PyTorch's own index first means pip
# won't later pull the CUDA variant as a transitive dependency of sentence-transformers.
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

COPY pyproject.toml ./
COPY src ./src
RUN pip install --no-cache-dir -e .

EXPOSE 8000

CMD ["uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
