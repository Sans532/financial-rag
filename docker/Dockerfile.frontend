FROM python:3.11-slim

WORKDIR /app

# The frontend only talks to the API over HTTP (see frontend/app.py) — it doesn't need
# the backend package or its heavy deps (torch, langgraph, qdrant-client, etc.), so we
# install just streamlit + requests directly rather than `pip install -e .`.
RUN pip install --no-cache-dir streamlit>=1.41.1 requests>=2.32.3

COPY frontend ./frontend

EXPOSE 8501

CMD ["streamlit", "run", "frontend/app.py", "--server.address=0.0.0.0", "--server.port=8501"]
