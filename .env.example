# Google Gemini (LLM for planner/synthesizer/verifier agents)
# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# SEC EDGAR requires a descriptive User-Agent identifying the app + contact email.
# See https://www.sec.gov/os/webmaster-faq#developers
SEC_USER_AGENT="financial-rag research-project you@example.com"

# Finnhub free tier (https://finnhub.io/register) — email signup, no card required.
FINNHUB_API_KEY=

# Qdrant — either point at a running server (docker-compose default: QDRANT_URL below)
# OR set QDRANT_LOCAL_PATH to run Qdrant embedded (on-disk, no server/Docker required).
# QDRANT_LOCAL_PATH takes priority over QDRANT_URL when both are set. Local mode only
# supports one process accessing the path at a time (no API + ingest script running
# concurrently against the same path).
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_LOCAL_PATH=

# Embedding model (local sentence-transformers, no API key needed)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# API server
API_HOST=0.0.0.0
API_PORT=8000

LOG_LEVEL=INFO
